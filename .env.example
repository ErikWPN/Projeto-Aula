# Copie para .env e preencha. O .env não vai para o Git.

# Senha do painel /admin (usuário: admin). Vazia: o servidor gera uma senha provisória e mostra no log.
ADMIN_SENHA=

# Dados do Pix que recebe os pagamentos. Enquanto a chave tiver "exemplo", o site fica em modo demonstração.
PIX_CHAVE=chave-pix@exemplo.com
PIX_NOME=Nome Como Aparece No Banco
PIX_CIDADE=Sao Paulo

# WhatsApp que recebe os comprovantes: 55 + DDD + número, só dígitos
MENTORIA_WHATSAPP=5511900000000

# Opcional: link de pagamento com cartão
MENTORIA_LINK_CARTAO=

# Atrás de um proxy com HTTPS (Render, Railway, Nginx), use framework. Exposto direto, deixe none.
FORWARD_HEADERS=none

# Senha do banco PostgreSQL (docker-compose)
POSTGRES_PASSWORD=troque-esta-senha
