# Copie para .env e preencha. O .env não vai para o Git.

# Senha do painel /admin (usuário: admin)
ADMIN_SENHA=troque-por-uma-senha-forte

# Dados do Pix que recebe os pagamentos
PIX_CHAVE=sua-chave-pix
PIX_NOME=Nome Como Aparece No Banco
PIX_CIDADE=Sao Paulo

# WhatsApp que recebe os comprovantes: 55 + DDD + número, só dígitos
MENTORIA_WHATSAPP=5511900000000

# Opcional: link de pagamento com cartão
MENTORIA_LINK_CARTAO=

# Senha do banco PostgreSQL (docker-compose)
POSTGRES_PASSWORD=troque-esta-senha
